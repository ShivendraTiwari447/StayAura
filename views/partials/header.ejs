<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= NAVBAR ================= -->

<div class="navbar">

    <!-- Logo -->

    <div class="logo">

        <a href="/listings" class="logo-title">
            🏖 StayAura
        </a>

        <span class="logo-tagline">
            Where Every Stay Has an Aura.
        </span>

    </div>

    <!-- Navigation -->

    <div class="links" id="navLinks">

        <a href="/listings">All Listings</a>

        <% if(currUser){ %>

            <a href="/listings/new" class="btn-create">
                + Create Listing
            </a>

            <span class="user-badge">
                👋 <%= currUser.username %>
            </span>

            <a href="/logout" class="btn-logout">
                Logout
            </a>

        <% } else { %>

            <a href="/login" class="btn-login">
                Login
            </a>

            <a href="/signup" class="btn-signup">
                Sign Up
            </a>

        <% } %>

    </div>

    <!-- Hamburger -->

    <div class="hamburger" id="hamburger">
        <div></div>
        <div></div>
        <div></div>
    </div>

</div>

<%- include("./flash") %>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:"Segoe UI",sans-serif;
    background:#f8f9fa;
}

/* ================= NAVBAR ================= */

.navbar{

    display:flex;
    justify-content:space-between;
    align-items:center;

    background:#ffffff;

    padding:15px 28px;

    border-radius:12px;

    margin-bottom:25px;

    box-shadow:0 4px 14px rgba(0,0,0,.08);

    transition:.3s ease;

}

.navbar:hover{

    box-shadow:0 8px 22px rgba(0,0,0,.12);

}

/* ================= LOGO ================= */

.logo{

    display:flex;

    flex-direction:column;

    justify-content:center;

}

.logo-title{

    text-decoration:none;

    color:#0d6efd;

    font-size:30px;

    font-weight:700;

    transition:.3s;

}

.logo-title:hover{

    color:#0b5ed7;

}

.logo-tagline{

    font-size:11px;

    color:#6c757d;

    margin-top:2px;

    letter-spacing:.4px;

    font-style:italic;

}

/* ================= LINKS ================= */

.links{

    display:flex;

    align-items:center;

    gap:15px;

}

.links a{

    text-decoration:none;

    font-weight:600;

    color:#333;

    transition:.25s;

}

.links>a:first-child:hover{

    color:#0d6efd;

}


/* ================= CREATE BUTTON ================= */

.btn-create{
    background:linear-gradient(135deg,#22c55e,#16a34a);
    color:#fff !important;
    padding:9px 18px;
    border-radius:10px;
    transition:all .3s ease;
    box-shadow:0 4px 10px rgba(34,197,94,.25);
}

.btn-create:hover{
    background:linear-gradient(135deg,#16a34a,#15803d);
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(34,197,94,.35);
}

/* ================= LOGIN BUTTON ================= */

.btn-login{
    background:#ffffff;
    color:#0d6efd !important;
    border:2px solid #0d6efd;
    padding:9px 18px;
    border-radius:10px;
    transition:all .3s ease;
}

.btn-login:hover{
    background:#0d6efd;
    color:#fff !important;
    transform:translateY(-2px);
}

/* ================= SIGNUP BUTTON ================= */

.btn-signup{
    background:linear-gradient(135deg,#3b82f6,#2563eb);
    color:#fff !important;
    padding:9px 18px;
    border-radius:10px;
    transition:all .3s ease;
    box-shadow:0 4px 10px rgba(37,99,235,.25);
}

.btn-signup:hover{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(37,99,235,.35);
}

/* ================= LOGOUT BUTTON ================= */

.btn-logout{
    background:linear-gradient(135deg,#ef4444,#dc2626);
    color:#fff !important;
    padding:9px 18px;
    border-radius:10px;
    transition:all .3s ease;
    box-shadow:0 4px 10px rgba(239,68,68,.25);
}

.btn-logout:hover{
    background:linear-gradient(135deg,#dc2626,#b91c1c);
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(239,68,68,.35);
}

/* ================= USER BADGE ================= */

.user-badge{
    background:#f8fbff;
    border:1px solid #d9e7ff;
    color:#0d6efd;
    border-radius:25px;
    padding:8px 15px;
    font-weight:600;
    transition:.3s ease;
}

.user-badge:hover{
    background:#eef5ff;
}

/* ================= HAMBURGER ================= */

.hamburger{
    display:none;
    flex-direction:column;
    cursor:pointer;
}

.hamburger div{
    width:26px;
    height:3px;
    background:#333;
    margin:4px 0;
    border-radius:4px;
    transition:.3s;
}

.hamburger:hover div{
    background:#0d6efd;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .hamburger{
        display:flex;
    }

    .links{
        display:none;
        position:absolute;
        top:78px;
        left:15px;
        right:15px;
        background:#fff;
        flex-direction:column;
        padding:20px;
        border-radius:12px;
        box-shadow:0 8px 20px rgba(0,0,0,.12);
        z-index:999;
    }

    .links.active{
        display:flex;
    }

    .links a,
    .user-badge{
        width:100%;
        text-align:center;
    }

    .logo-title{
        font-size:24px;
    }

    .logo-tagline{
        font-size:10px;
    }
}



</style>

<script>

const hamburger = document.getElementById("hamburger");
const navLinks = document.getElementById("navLinks");

// ================= MOBILE MENU =================

hamburger.addEventListener("click", () => {

    navLinks.classList.toggle("active");

});

// ================= CLOSE MENU AFTER CLICK =================

const navItems = document.querySelectorAll("#navLinks a");

navItems.forEach((item) => {

    item.addEventListener("click", () => {

        navLinks.classList.remove("active");

    });

});

</script>