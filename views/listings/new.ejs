<%- include('../partials/header', { title: 'Create New Listing' }) %>

<div class="container" style="max-width:600px; margin:auto; background:white; padding:20px; border-radius:10px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">

  <a class="back" href="/listings" style="display:inline-block; margin-bottom:15px; color:blue; text-decoration:none;">
    ← Back to Listings
  </a>

  <h2 style="text-align:center; margin-bottom:20px;">Create New Listing</h2>

  <form
    action="/listings"
    method="POST"
    enctype="multipart/form-data"
    class="needs-validation"
    novalidate
  >

    <!-- Title -->
    <div class="mb-3">
      <input
        type="text"
        name="title"
        placeholder="Title"
        class="form-control"
        required
      >
      <div class="valid-feedback">
        Looks good!
      </div>
      <div class="invalid-feedback">
        Please enter a title.
      </div>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <textarea
        name="description"
        placeholder="Description"
        rows="3"
        class="form-control"
      ></textarea>
    </div>

    <!-- Price -->
    <div class="mb-3">
      <input
        type="number"
        name="price"
        placeholder="Price"
        class="form-control"
        required
      >
      <div class="valid-feedback">
        Price looks good!
      </div>
      <div class="invalid-feedback">
        Please enter a valid price.
      </div>
    </div>

    <!-- Location -->
    <div class="mb-3">
      <input
        type="text"
        name="location"
        placeholder="Location"
        class="form-control"
        required
      >
      <div class="valid-feedback">
        Looks good!
      </div>
      <div class="invalid-feedback">
        Please enter a location.
      </div>
    </div>

    <!-- Country -->
    <div class="mb-3">
      <input
        type="text"
        name="country"
        placeholder="Country"
        class="form-control"
        required
      >
      <div class="valid-feedback">
        Looks good!
      </div>
      <div class="invalid-feedback">
        Please enter a country.
      </div>
    </div>

    <!-- Image Upload -->
    <div class="mb-3">
      <label class="form-label">Upload Image</label>
      <input
        type="file"
        name="image"
        class="form-control"
        accept="image/*"
        required
      >
      <div class="valid-feedback">
        Image selected!
      </div>
      <div class="invalid-feedback">
        Please upload an image.
      </div>
    </div>

    <button type="submit" class="btn btn-success w-100">
      Add Listing
    </button>

  </form>

</div>

<%- include('../partials/footer') %>