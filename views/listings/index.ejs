<%- include('../partials/header', { title: 'All Listings' }) %>


<h1 style="text-align:center; margin-bottom:25px;">All Listings</h1>

<!-- Listings Grid -->
<div class="grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(250px,1fr)); gap:20px;">
  <% alllistings.forEach(listing => { %>
    <div class="card" style="background:white; border-radius:10px; box-shadow:0 4px 10px rgba(0,0,0,0.1); overflow:hidden; transition: transform 0.2s;">
      <a href="/listings/<%= listing._id %>" style="display:block;">
        <img src="<%= listing.image.url %>" alt="listing image" style="width:100%; height:180px; object-fit:cover; display:block;">
        <div class="card-content" style="padding:15px; text-align:center; font-weight:bold; font-size:18px; color:#333;">
          <%= listing.title %>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<%- include('../partials/footer') %>
