
<%- include('../partials/header', { title: 'Edit Listing' }) %>

<div class="container" style="max-width:600px; margin:auto; background:white; padding:20px; border-radius:10px; box-shadow:0 4px 10px rgba(0,0,0,0.1);">
  
  <a class="back" href="/listings/<%= listing._id %>" style="display:inline-block; margin-bottom:15px; color:blue; text-decoration:none;">← Back to Listing</a>

  <h2 style="text-align:center; margin-bottom:20px;">Edit Listing</h2>

  <form action="/listings/<%= listing._id %>?_method=PUT" 
        method="POST"
        class="needs-validation"
        novalidate>

    <input 
      type="text" 
      name="title" 
      class="form-control mb-3"
      placeholder="Title" 
      value="<%= listing.title %>" 
      required>
    <div class="invalid-feedback">
      Please enter a title.
    </div>

    <textarea 
      name="description" 
      class="form-control mb-3"
      placeholder="Description" 
      rows="3"><%= listing.description %></textarea>

    <input 
      type="number" 
      name="price" 
      class="form-control mb-3"
      placeholder="Price" 
      value="<%= listing.price %>" 
      required>
    <div class="invalid-feedback">
      Please enter a valid price.
    </div>

    <input 
      type="text" 
      name="location" 
      class="form-control mb-3"
      placeholder="Location" 
      value="<%= listing.location %>" 
      required>
    <div class="invalid-feedback">
      Please enter a location.
    </div>

    <input 
      type="text" 
      name="country" 
      class="form-control mb-3"
      placeholder="Country" 
      value="<%= listing.country %>" 
      required>
    <div class="invalid-feedback">
      Please enter a country.
    </div>

    <input 
      type="url" 
      name="imageUrl" 
      class="form-control mb-3"
      placeholder="Image URL" 
      value="<%= listing.image.url %>">
    <div class="invalid-feedback">
      Please enter a valid URL.
    </div>

    <button 
      type="submit" 
      class="btn btn-warning">
      Update Listing
    </button>

  </form>

</div>

<%- include('../partials/footer') %>